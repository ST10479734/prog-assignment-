CREATE DATABASE raceday;

use raceday

create table users(
user_ID int identity(1,1) primary key,
fullname varchar(100) not null,
role varchar(50) not null,
email varchar (100) not null,
password varchar (255)not null);

create table events(
event_ID int identity (1,1) primary key,
organizer_ID int not null,
FOREIGN KEY (organizer_ID) REFERENCES users(user_ID),
eventname VARCHAR(150) NOT NULL, 
location VARCHAR(200) NOT NULL, 
eventdate DATETIME NOT NULL);

CREATE TABLE routes (
route_ID INT IDENTITY(1,1) PRIMARY KEY,
event_ID INT NOT NULL,
FOREIGN KEY (event_ID) REFERENCES events(event_ID),
startpoint VARCHAR(200) NOT NULL,
endpoint varchar (200) not null);

CREATE TABLE category (
category_ID INT IDENTITY (1,1) PRIMARY KEY,
categoryname varchar (300),
event_ID INT NOT NULL,
FOREIGN KEY (event_ID) REFERENCES events(event_ID),
distance varchar (100) not null,
eventtype varchar (200) not null);

CREATE TABLE enrolment (
enrolment_ID INT IDENTITY(1,1) PRIMARY KEY,
user_ID INT NOT NULL,
FOREIGN KEY (user_ID) REFERENCES users(user_ID),
category_ID INT NOT NULL,
FOREIGN KEY (category_ID) REFERENCES category (category_ID),
enrolment_date date not null,
racenumber VARCHAR(20) NOT NULL,
paymentstatus VARCHAR(20));

CREATE TABLE PAYMENT(
payment_ID INT IDENTITY (1, 1) PRIMARY KEY,
enrolment_ID INT NOT NULL,
FOREIGN KEY (enrolment_ID) REFERENCES enrolment(enrolment_ID),
amount VARCHAR (200) NOT NULL,
paymentdate date not null,
method VARCHAR(50) NOT NULL);

CREATE TABLE results (
results_ID INT IDENTITY(1,1) PRIMARY KEY,
enrolment_ID INT NOT NULL,
FOREIGN KEY (enrolment_ID) REFERENCES enrolment(enrolment_ID),
finishtime TIME NOT NULL,
overallposition INT NOT NULL,
categoryposition INT NOT NULL);
